# Optional local values for Docker/Kubernetes experiments.
# docker-compose.yml already includes safe local defaults, so this file is
# mainly a reference when you want to externalize the values later.

MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_DATABASE=comicverse
MYSQL_USER=comicverse
MYSQL_PASSWORD=comicverse-password

DB_URL=jdbc:mysql://mysql:3306/comicverse?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=utf8
DB_USERNAME=comicverse
DB_PASSWORD=comicverse-password

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=comicverse-local
AWS_ACCESS_KEY_ID=local-access-key
AWS_SECRET_ACCESS_KEY=local-secret-key

PAYOS_CLIENT_ID=local-payos-client
PAYOS_API_KEY=local-payos-api-key
PAYOS_CHECKSUM_KEY=local-payos-checksum-key

APP_JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
APP_JWT_EXPIRATION_MS=86400000

VITE_API_BASE_URL=/api
