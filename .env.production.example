# Copy to .env.production on your VPS/server and fill real values.
# Never commit .env.production.

# Backend database connection.
# Use your real MySQL/PostgreSQL service here. docker-compose.prod.yml does not
# expose or run a database container by default.
DB_URL=jdbc:mysql://your-db-host:3306/comicverse?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=utf8
DB_USERNAME=comicverse
DB_PASSWORD=replace-with-long-random-db-password

# Redis
REDIS_PASSWORD=replace-with-long-random-redis-password
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace-with-long-random-redis-password

# Backend runtime
SPRING_JPA_SHOW_SQL=false
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com
APP_JWT_SECRET=replace-with-base64-encoded-256-bit-or-longer-secret
APP_JWT_EXPIRATION_MS=86400000
GOOGLE_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
PASSWORD_RESET_OTP_EXPIRATION_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# AWS S3
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-real-s3-bucket
AWS_ACCESS_KEY_ID=replace-with-real-access-key
AWS_SECRET_ACCESS_KEY=replace-with-real-secret-key

# PayOS
PAYOS_CLIENT_ID=replace-with-payos-client-id
PAYOS_API_KEY=replace-with-payos-api-key
PAYOS_CHECKSUM_KEY=replace-with-payos-checksum-key
