<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_primary">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:background="@color/bg_dark_primary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/baseline_arrow_back_24"
            app:navigationIconTint="@android:color/white">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubscribe"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/margin_medium"
                app:cornerRadius="@dimen/margin_small"
                app:strokeColor="@android:color/white"
                android:text="@string/action_subscribe"
                android:textColor="@android:color/white" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/scroll_padding_bottom">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/margin_large"
            android:paddingTop="@dimen/margin_large">

            <!-- Cover Image -->
            <ImageView
                android:id="@+id/imgCover"
                android:layout_width="@dimen/cover_width"
                android:layout_height="@dimen/cover_height"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/bg_icon_rounded"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic" />

            <!-- Title -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xlarge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgCover"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                tools:text="Tiên Nghịch" />

            <!-- Metadata Info Rows -->
            <TextView
                android:id="@+id/txtAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTitle"
                android:drawablePadding="@dimen/margin_medium_small"
                app:drawableStartCompat="@drawable/ic_writer"
                app:drawableTint="@color/icon_yellow"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_normal"
                tools:text="Nhĩ Căn" />

            <TextView
                android:id="@+id/txtUpdateDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtAuthor"
                android:drawablePadding="@dimen/margin_medium_small"
                app:drawableStartCompat="@android:drawable/ic_menu_my_calendar"
                app:drawableTint="@color/icon_cyan"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_normal"
                tools:text="22/10/2025 03:47" />

            <TextView
                android:id="@+id/txtSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtUpdateDate"
                android:drawablePadding="@dimen/margin_medium_small"
                app:drawableStartCompat="@android:drawable/ic_info"
                app:drawableTint="@color/icon_light_blue"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_normal"
                tools:text="NovelVN" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtSource"
                android:drawablePadding="@dimen/margin_medium_small"
                app:drawableStartCompat="@android:drawable/ic_media_play"
                app:drawableTint="@color/status_completed"
                android:textColor="@color/status_completed"
                android:textSize="@dimen/text_size_normal"
                tools:text="Đã hoàn thành" />

            <TextView
                android:id="@+id/btnReport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtStatus"
                android:drawablePadding="@dimen/margin_medium_small"
                android:background="?attr/selectableItemBackground"
                app:drawableStartCompat="@android:drawable/ic_dialog_alert"
                app:drawableTint="@color/btn_report_text"
                android:textColor="@color/btn_report_text"
                android:textSize="@dimen/text_size_normal"
                android:text="@string/action_report"
                android:clickable="true"
                android:focusable="true" />

            <!-- Tags (Genres) -->
            <HorizontalScrollView
                android:id="@+id/scrollTags"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xlarge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnReport"
                android:scrollbars="none">
                
                <LinearLayout
                    android:id="@+id/layoutTags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Synopsis Section -->
            <ImageView
                android:id="@+id/icSynopsisStar"
                android:layout_width="@dimen/margin_xlarge"
                android:layout_height="@dimen/margin_xlarge"
                android:layout_marginTop="@dimen/margin_xxlarge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scrollTags"
                android:src="@android:drawable/star_on"
                app:tint="@color/icon_yellow" />

            <TextView
                android:id="@+id/txtSynopsisTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                app:layout_constraintBottom_toBottomOf="@id/icSynopsisStar"
                app:layout_constraintEnd_toStartOf="@id/icSynopsisExpand"
                app:layout_constraintStart_toEndOf="@id/icSynopsisStar"
                app:layout_constraintTop_toTopOf="@id/icSynopsisStar"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_large"
                android:text="@string/title_synopsis"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/icSynopsisExpand"
                android:layout_width="@dimen/margin_xlarge"
                android:layout_height="@dimen/margin_xlarge"
                app:layout_constraintBottom_toBottomOf="@id/icSynopsisStar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/icSynopsisStar"
                android:src="@android:drawable/arrow_down_float"
                app:tint="@android:color/white" />

            <!-- Invisible View to handle clicks for Synopsis Expand cleanly without wrapping LinearLayout -->
            <View
                android:id="@+id/btnExpandSynopsis"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@id/icSynopsisStar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/icSynopsisStar"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/txtSynopsis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/icSynopsisStar"
                android:textColor="@color/text_synopsis"
                android:textSize="@dimen/text_size_normal"
                android:ellipsize="end"
                android:lineSpacingExtra="6dp"
                android:maxLines="3"
                tools:text="Bạn đang đọc truyện Tiên Nghịch full (đã hoàn thành) của tác giả Nhĩ Căn. Vương Lâm, một thiếu niên..." />

            <!-- Latest Chapters -->
            <ImageView
                android:id="@+id/icChaptersLatest"
                android:layout_width="@dimen/margin_xlarge"
                android:layout_height="@dimen/margin_xlarge"
                android:layout_marginTop="@dimen/margin_xxlarge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtSynopsis"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="@color/icon_red" />

            <TextView
                android:id="@+id/txtChaptersTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                app:layout_constraintBottom_toBottomOf="@id/icChaptersLatest"
                app:layout_constraintEnd_toStartOf="@id/icChaptersNext"
                app:layout_constraintStart_toEndOf="@id/icChaptersLatest"
                app:layout_constraintTop_toTopOf="@id/icChaptersLatest"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_large"
                android:text="@string/title_latest_chapters"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/icChaptersNext"
                android:layout_width="@dimen/margin_xlarge"
                android:layout_height="@dimen/margin_xlarge"
                app:layout_constraintBottom_toBottomOf="@id/icChaptersLatest"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/icChaptersLatest"
                android:src="@android:drawable/ic_media_next"
                app:tint="@android:color/white" />

            <!-- Invisible View to handle clicks for Chapters Expand -->
            <View
                android:id="@+id/btnViewAllChapters"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@id/icChaptersLatest"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/icChaptersLatest"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <!-- The list of chapters, must remain a Vertical View as it gets dynamically inflated -->
            <LinearLayout
                android:id="@+id/layoutChapters"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/icChaptersLatest"
                android:orientation="vertical" />

            <!-- Comments -->
            <ImageView
                android:id="@+id/icComments"
                android:layout_width="@dimen/margin_xlarge"
                android:layout_height="@dimen/margin_xlarge"
                android:layout_marginTop="@dimen/margin_xxlarge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutChapters"
                android:src="@android:drawable/stat_notify_chat"
                app:tint="@color/icon_cyan" />

            <TextView
                android:id="@+id/txtCommentsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                app:layout_constraintBottom_toBottomOf="@id/icComments"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/icComments"
                app:layout_constraintTop_toTopOf="@id/icComments"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_large"
                android:text="@string/title_comments"
                android:textStyle="bold" />

            <!-- Actual Comments List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComicComments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/icComments"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_comment" />

            <!-- Empty State for Comments List -->
            <TextView
                android:id="@+id/tvEmptyComicComments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rvComicComments"
                android:gravity="center"
                android:visibility="gone"
                android:textColor="@color/text_hint_gray"
                android:textSize="@dimen/text_size_normal"
                android:text="Chưa có bình luận nào. Hãy là người đầu tiên!" />

            <!-- Comment Pagination Control -->
            <LinearLayout
                android:id="@+id/layoutCommentPagination"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvEmptyComicComments">

                <ImageButton
                    android:id="@+id/btnPrevPage"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="@android:color/white"
                    android:contentDescription="Previous Page" />

                <TextView
                    android:id="@+id/tvCurrentPage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Trang 1 / 1" />

                <ImageButton
                    android:id="@+id/btnNextPage"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="@android:color/white"
                    android:contentDescription="Next Page" />
            </LinearLayout>

            <!-- Comment Input Section -->
            <LinearLayout
                android:id="@+id/layoutCommentInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutCommentPagination">

                <EditText
                    android:id="@+id/etComicComment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Viết bình luận..."
                    android:background="@drawable/bg_search_box"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:textColorHint="@color/text_hint_gray"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:maxLines="4"
                    android:inputType="textMultiLine" />

                <ImageButton
                    android:id="@+id/btnSendComicComment"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_send"
                    app:tint="@color/icon_light_blue"
                    android:contentDescription="Send comment" />
            </LinearLayout>

            <!-- Similar Novels -->
            <ImageView
                android:id="@+id/icSimilar"
                android:layout_width="@dimen/margin_xlarge"
                android:layout_height="@dimen/margin_xlarge"
                android:layout_marginTop="@dimen/margin_xxlarge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutCommentInput"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/icon_orange" />

            <TextView
                android:id="@+id/txtSimilarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                app:layout_constraintBottom_toBottomOf="@id/icSimilar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/icSimilar"
                app:layout_constraintTop_toTopOf="@id/icSimilar"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_large"
                android:text="@string/title_similar_novels"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSimilar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/icSimilar"
                android:clipToPadding="false" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Read Action -->
    <LinearLayout
        android:id="@+id/btnStartReading"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_bar_height"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/bg_start_reading"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/txtStartReadingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_size_xlarge"
            android:text="@string/action_start_reading"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStartReadingSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_subtitle_light"
            android:textSize="@dimen/text_size_small"
            tools:text="Chương 1" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
