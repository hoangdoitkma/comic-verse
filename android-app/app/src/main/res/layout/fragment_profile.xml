<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_primary">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/scroll_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_medium">

            <!-- Profile Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_dark_surface"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/stroke_divider">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_large">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:src="@drawable/baseline_arrow_back_24"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/text_primary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/imageAvatar"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@mipmap/ic_launcher"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:orientation="vertical"
                        app:layout_constraintStart_toEndOf="@id/btnBack"
                        app:layout_constraintEnd_toStartOf="@id/imageAvatar"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/textProfileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đăng nhập hoặc đăng ký"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_large"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textVipStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_rank_badge"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Thành viên VIP"
                            android:textColor="@color/icon_yellow"
                            android:textSize="@dimen/text_size_small"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xxlarge"
                android:layout_marginBottom="@dimen/margin_small"
                android:layout_marginStart="@dimen/margin_small"
                android:text="Tính năng"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <!-- Features Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_dark_surface"
                app:cardCornerRadius="@dimen/radius_medium"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/stroke_divider">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowReaderSettings"
                        layout="@layout/item_setting_row" />
                    
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke_divider" />

                    <include
                        android:id="@+id/rowReadingHistory"
                        layout="@layout/item_setting_row" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke_divider" />

                    <include
                        android:id="@+id/rowDownloadList"
                        layout="@layout/item_setting_row" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke_divider" />

                    <include
                        android:id="@+id/rowClearCache"
                        layout="@layout/item_setting_row" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_marginBottom="@dimen/margin_small"
                android:layout_marginStart="@dimen/margin_small"
                android:text="Liên hệ và hỗ trợ"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <!-- Support Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_dark_surface"
                app:cardCornerRadius="@dimen/radius_medium"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/stroke_divider">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowEmail"
                        layout="@layout/item_setting_row" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke_divider" />

                    <include
                        android:id="@+id/rowFacebook"
                        layout="@layout/item_setting_row" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke_divider" />

                    <include
                        android:id="@+id/rowWebsite"
                        layout="@layout/item_setting_row" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Disclaimer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xxlarge"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margin_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Miễn trừ trách nhiệm"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:gravity="center"
                    android:text="Ứng dụng này cung cấp nội dung giải trí không chịu trách nhiệm pháp lý. Nguồn dữ liệu từ internet..."
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="Email: comicfan.official@gmail.com"
                    android:textColor="@color/icon_light_blue"
                    android:textSize="@dimen/text_size_normal" />

                <TextView
                    android:id="@+id/textVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:background="@drawable/bg_version_badge"
                    android:paddingHorizontal="@dimen/margin_medium_small"
                    android:paddingVertical="@dimen/margin_tiny"
                    android:text="Phiên bản: 1.0.0"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_tiny" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#F21A1D24"
        app:itemIconTint="@color/text_primary"
        app:itemRippleColor="@color/text_secondary"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/menu_home_bottom"
        app:elevation="16dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
