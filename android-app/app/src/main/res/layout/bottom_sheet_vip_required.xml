<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dark"
    android:orientation="vertical"
    android:paddingTop="32dp"
    android:paddingBottom="24dp"
    android:paddingHorizontal="24dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/imgVipIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_vip"
        android:background="@drawable/bg_circle"
        android:backgroundTint="#26FFC107"
        android:padding="16dp"
        app:tint="@color/icon_yellow" />

    <TextView
        android:id="@+id/tvVipTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nội dung tính phí"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_xlarge"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvVipMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chương này yêu cầu tài khoản VIP. Bạn cần nâng cấp để truy cập không giới hạn nội dung cao cấp."
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_normal"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:id="@+id/btnPrimaryAction"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_gradient_button"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true">
        
        <TextView
            android:id="@+id/tvPrimaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nâng cấp ngay"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_large" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Để sau"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_normal"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>
