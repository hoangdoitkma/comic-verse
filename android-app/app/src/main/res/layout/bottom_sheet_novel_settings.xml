<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cài đặt giao diện đọc"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Text Size -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cỡ chữ"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">
        <Button
            android:id="@+id/btnSizeDecrease"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="A-" />
        <TextView
            android:id="@+id/tvCurrentSize"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="16"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="@color/black" />
        <Button
            android:id="@+id/btnSizeIncrease"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="A+" />
    </LinearLayout>

    <!-- Theme -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Màu nền"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />
        
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <Button
            android:id="@+id/btnThemeLight"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#000000"
            android:text="Sáng" />
        <Space android:layout_width="8dp" android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btnThemeSepia"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:backgroundTint="#F4ECD8"
            android:textColor="#5B4636"
            android:text="Vàng" />
        <Space android:layout_width="8dp" android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btnThemeDark"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:backgroundTint="#222222"
            android:textColor="#FFFFFF"
            android:text="Tối" />
    </LinearLayout>

    <!-- Auto Scroll Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">
        
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Tự động cuộn"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:textStyle="bold" />
            
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAutoScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutAutoScrollSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Speed -->
        <TextView
            android:id="@+id/tvScrollSpeedLbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tốc độ cuộn"
            android:textSize="14sp"
            android:textColor="#666666" />
            
        <SeekBar
            android:id="@+id/seekBarSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:max="10"
            android:progress="2" />

        <!-- Conflict Mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thao tác khi chạm tay vào màn hình"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />
            
        <RadioGroup
            android:id="@+id/rgConflictMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            
            <RadioButton
                android:id="@+id/rbStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:text="Hủy tính năng" />
                
            <RadioButton
                android:id="@+id/rbPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:text="Tạm dừng chờ" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvAutoScrollHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="#999999"
            android:layout_marginBottom="8dp"
            android:text="" />
    </LinearLayout>

</LinearLayout>
