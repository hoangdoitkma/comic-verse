<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:startColor="#0288D1"
                android:endColor="#2E6BFF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:startColor="#4FC3F7"
                android:endColor="#2878FF"
                android:type="linear" />
        </shape>
    </item>
</selector>
